# Neon exclusivo do DrawAnalysis
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Sessões (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
AUTH_SECRET="replace-with-a-long-random-secret"

# Use "tactidraw" in the current deployment, "gameplan" in the second and
# "written-report" in the third deployment.
# The public value controls the visible brand; APP_VARIANT protects the server-side project scope.
APP_VARIANT="tactidraw"
NEXT_PUBLIC_APP_VARIANT="tactidraw"

# Conta inicial opcional. A password nunca é guardada em texto simples.
INITIAL_ADMIN_NAME="Paulo"
INITIAL_ADMIN_USERNAME="paulo"
INITIAL_ADMIN_WORKSPACE="Paulo Workspace"
INITIAL_ADMIN_PASSWORD=""

# Catálogo cloud partilhado (os mesmos valores usados pelas outras aplicações)
MEDIA_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
MEDIA_DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
MEDIA_LIBRARY_APP_ID="draw-analysis"

# Cloudflare R2 partilhado — leitura e upload multipart direto do browser
MEDIA_R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
MEDIA_R2_BUCKET_NAME=""
MEDIA_R2_ACCESS_KEY_ID=""
MEDIA_R2_SECRET_ACCESS_KEY=""
